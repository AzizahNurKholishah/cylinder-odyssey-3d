# memory = data contoh di RAM (pengembangan); supabase = produksi
DATA_BACKEND=memory

# Wajib untuk DATA_BACKEND=supabase (JANGAN pernah taruh di frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Wajib untuk produksi: string acak minimal 32 karakter
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# Kunci tambahan untuk login akun guru (default dev: guru-dev-123)
TEACHER_ACCESS_KEY=

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
LOGIN_RATE_LIMIT=10
